# PostgreSQL connection string (e.g. from Neon, Supabase, Railway, etc.)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Reddit API credentials (from https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret

# OpenAI API key (from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key

# Your Docker Hub username (used in docker-compose.portainer.yml)
DOCKERHUB_USERNAME=your_dockerhub_username

# URL the browser uses to reach the backend
# For production: https://api.redengine.upengine.app
# For local Docker: http://localhost:5000
NEXT_PUBLIC_API_URL=https://api.redengine.upengine.app
